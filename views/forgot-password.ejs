<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | Budget Planner</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;800&family=Manrope:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <p class="eyebrow">Budget Planner</p>
        <h1>Forgot password</h1>
        <p class="subtext">Enter your email and we will generate a reset link.</p>

        <% if (error) { %>
          <div class="error"><%= error %></div>
        <% } %>

        <% if (info) { %>
          <div class="info"><%= info %></div>
        <% } %>

        <% if (resetLink) { %>
          <div class="dev-note">
            Development reset link:
            <a href="<%= resetLink %>">Open reset page</a>
          </div>
        <% } %>

        <form method="POST" action="/forgot-password" class="form-stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <label>
            Email
            <input type="email" name="email" required value="<%= email %>" />
          </label>
          <button type="submit" class="btn-primary">Generate Reset Link</button>
        </form>

        <p class="auth-switch">
          Remembered your password?
          <a href="/login">Back to login</a>
        </p>
      </section>
    </main>
    <script src="/app.js"></script>
  </body>
</html>
