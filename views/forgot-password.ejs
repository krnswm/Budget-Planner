<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | Budget Planner</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <p class="eyebrow">Budget Planner</p>
        <h1>Forgot password</h1>
        <p class="subtext">Enter your email and we will generate a reset link.</p>

        <% if (error) { %>
          <div class="error" role="alert"><%= error %></div>
        <% } %>

        <% if (info) { %>
          <div class="info" role="status"><%= info %></div>
        <% } %>

        <% if (resetLink) { %>
          <div class="dev-note">
            Development reset link:
            <a href="<%= resetLink %>">Open reset page</a>
          </div>
        <% } %>

        <form method="POST" action="/forgot-password" class="form-stack">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div>
            <label for="email">Email</label>
            <input id="email" type="email" name="email" autocomplete="email" required value="<%= email %>" />
          </div>
          <button type="submit" class="btn-primary">Generate Reset Link</button>
        </form>

        <p class="auth-switch">
          Remembered your password?
          <a href="/login">Back to login</a>
        </p>
      </section>
    </main>
  </body>
</html>
