# Copy to .env and fill in. Never commit .env itself.

# ---- Database (required) -------------------------------------------------
# Pooled connection string from the Neon dashboard. The host must contain
# "-pooler": the direct endpoint runs out of connections once several
# serverless invocations are warm at once.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# A SEPARATE Neon branch for the test suite. The tests write real rows, so
# pointing this at the same database as DATABASE_URL will corrupt live data.
# Neon branches are free and instant. DB-backed tests skip if this is unset.
TEST_DATABASE_URL=

# ---- App -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_DOMAIN=
FORCE_HTTPS=false
TRUST_PROXY=1

# ---- Sessions ------------------------------------------------------------
# Must be 32+ characters in production; the app refuses to boot otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_SAMESITE=lax

# Optional. Leave blank to use the local SQLite session store.
REDIS_URL=

# ---- Google sign-in (optional) -------------------------------------------
# All three or none. A partial config fails at boot rather than silently
# dropping the sign-in button from the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
